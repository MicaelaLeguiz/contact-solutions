// Data model - Contact Solutions / Global Experience

Table CALLS {
  call_id int [pk]
  customer_id int [ref: > CUSTOMERS.customer_id]
  agent_id int [ref: > AGENTS.agent_id]
  campaign_id int [ref: > CAMPAIGNS.campaign_id]
  call_date date [ref: > DATE_DIM.date]
  start_time time
  end_time time
  call_direction varchar [note: 'Inbound, Outbound. Inbound: IVR, WhatsApp. Outbound: Phone, WhatsApp']
  channel varchar [note: 'Phone, IVR, WhatsApp']
  call_reason varchar [note: 'Initial Contact, Follow-up, Commercial Inquiry, Sales Closure']
  call_result varchar [note: 'Answered, No Answer, Voicemail, Invalid Number, Busy, Customer Abandoned']
  acd_time_seconds int [note: 'Effective conversation time between customer and agent']
  hold_time_seconds int [note: 'Time the customer spends on hold during transfers or internal checks']
  acw_time_seconds int [note: 'After Call Work performed by the agent before becoming available']
  available_time_seconds int [note: 'Time the agent remained available before receiving this interaction']
  abandon_time_seconds int [note: 'Waiting time before the customer abandoned the call']
  call_duration_seconds int
  csat_score int
}

Table AGENTS {
  agent_id int [pk]
  full_name varchar
  agent_type varchar [note: 'Human, AI']
  supervisor varchar
  account varchar
  employment_type varchar [note: 'Full-time, Part-time']
  hire_date date
  termination_date date [note: 'NULL if the agent is still active']
}

Table COSTS {
  cost_id int [pk]
  date date [ref: > DATE_DIM.date, note: 'Monthly costs are recorded on the first day of each month. This date represents the reporting period rather than the actual transaction date']
  agent_type varchar [note: 'Human, AI, Shared']
  cost_category varchar [note: 'Payroll, Internal Commission, AI License, Cloud Infrastructure, AI Usage, Training, Supervision']
  cost_type varchar [note: 'Fixed, Variable']
  amount decimal
}

Table CAMPAIGNS {
  campaign_id int [pk]
  campaign_name varchar
  destination varchar
  country varchar
  product_type varchar [note: 'Cruise, Europe, Caribbean, Vacation Package']
  list_price decimal
  discount decimal
  monthly_target int
  start_date date
  end_date date
}

Table CUSTOMERS {
  customer_id int [pk]
  full_name varchar
  age int
  province varchar
  country varchar
  registration_date date
  is_new_customer bool
  trip_count int
  customer_tier varchar [note: 'Standard, Gold, Premium']
  primary_campaign_id int [ref: > CAMPAIGNS.campaign_id, note: 'Campaign recommended by Global Experience. This value is provided by the client and is not generated by analytical models']
  secondary_campaign_id int [ref: > CAMPAIGNS.campaign_id]
  opportunity_status varchar [note: 'Prospect, Pending Sale, Confirmed Sale, Lost. Current opportunity status only. Historical changes are intentionally excluded from the project scope']
}

Table SALES {
  sale_id int [pk]
  customer_id int [ref: > CUSTOMERS.customer_id]
  campaign_id int [ref: > CAMPAIGNS.campaign_id]
  sale_date date [ref: > DATE_DIM.date]
  payment_date date [ref: > DATE_DIM.date]
  payment_status varchar [note: 'Paid, Pending, Cancelled']
  passenger_count int [note: 'Number of passengers included in the booking']
  sale_amount decimal [note: 'Final agreed sale amount. This value is independent from the campaign list price and may include discounts or agent negotiations']
  paid_amount decimal [note: 'Amount actually collected from the customer']
  commission_rate decimal
  commission_amount decimal [note: 'Commission paid by Global Experience to Contact Solutions for this sale, represents revenue, not agent payout. Agent commission is modeled separately in COSTS base as Internal commission']
}

Table DATE_DIM {
  date date [pk]
  day int
  week int
  month int
  quarter int
  year int
}
